+def get_loop_bb_vas(f):
+    """
+    the addresses of the basic blocks in loops:
+    strongly connected components of two or more blocks, or a block that branches to itself.
+    """
+    edges = get_bb_edges(f)
+    g = networkx.DiGraph()
+    g.add_edges_from(edges)
+    in_loop = set()
+    for comp in strongly_connected_components(g):
+        if len(comp) >= 2:
+            in_loop.update(comp)
+    in_loop.update(src for src, dst in edges if src == dst)
+    return in_loop
+
+
+def count_loop_byte_accesses(f):
+    """the instructions in loops that read or write a byte of memory, like `mov byte [edi], al`."""
+    loop_bb_vas = get_loop_bb_vas(f)
+    count = 0
+    for bb in f.basic_blocks:
+        if bb.va not in loop_bb_vas:
+            continue
+        for insn in bb.instructions:
+            if insn.mnem == "lea":
+                continue
+            if any(oper.isDeref() and oper.tsize == 1 for oper in insn.opers):
+                count += 1
+    return count
+
+
